# Terraform working files and state. State must only ever live in the remote backend.
.terraform/
.terraform.lock.hcl.bak
# Lock files are committed for root configurations (., bootstrap/,
# bootstrap/target-account/) and not for child modules, whose callers pin providers.
modules/*/.terraform.lock.hcl
*.tfstate
*.tfstate.*
crash.log
crash.*.log
.plans/
*.tfplan
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# env/*.tfvars and backend/*.hcl are committed on purpose: in this repo they hold
# only non-secret example values. If a real environment ever needs a secret, do not
# put it in a tfvars file; read it from Secrets Manager or SSM at runtime, or ignore
# such a file here (for example secret.auto.tfvars).
secret*.tfvars
*.auto.tfvars
